path = Path(filepath)
if path.suffix.lower() == '.csv':
    df = pd.read_csv(filepath)
elif path.suffix.lower() in ['.xlsx', '.xls']:
    df = pd.read_excel(filepath)
else:
    raise ValueError(f"Unsupported file format: {path.suffix}")


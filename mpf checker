class ModelPointsValidator:
“””
Comprehensive validator for actuarial model points files.

```
Usage:
    validator = ModelPointsValidator(df)
    result = validator.run_all_checks()
    validator.generate_report(result, 'validation_report.html')
"""

def __init__(self, df: pd.DataFrame, config: dict = None):
    """
    Initialize validator with a DataFrame.
    
    Args:
        df: Model points DataFrame
        config: Optional configuration overrides
    """
    self.df = df.copy()
    self.config = config or {}
    self.issues = []
    
    # Standardize column names (uppercase, strip whitespace)
    self.df.columns = [c.strip().upper() for c in self.df.columns]
    
def add_issue(self, check_name: str, severity: str, description: str, 
              mask: pd.Series = None, field_name: str = "", sample_size: int = 5):
    """Helper to add a validation issue."""
    if mask is not None and mask.any():
        affected_idx = self.df[mask].index.tolist()
        # Get sample values for context
        if field_name and field_name in self.df.columns:
            samples = self.df.loc[mask, field_name].head(sample_size).tolist()
        else:
            samples = []
        
        self.issues.append(ValidationIssue(
            check_name=check_name,
            severity=severity,
            description=description,
            affected_rows=affected_idx,
            sample_values=samples,
            field_name=field_name
        ))

# -------------------------------------------------------------------------
# 1. COMPLETENESS CHECKS
# -------------------------------------------------------------------------

def check_required_fields(self):
    """Check that all required fields are present and not null."""
    required_fields = [
        'POL_NUMBER', 'SPCODE', 'AGE_AT_ENTRY', 'SEX', 'POL_TERM_Y',
        'DURATIONIF_M', 'INIT_POLS_IF', 'PREM_FREQ', 'FILE_TYPE'
    ]
    
    # Check for missing columns
    missing_cols = [f for f in required_fields if f not in self.df.columns]
    if missing_cols:
        self.issues.append(ValidationIssue(
            check_name="Required Fields Present",
            severity="CRITICAL",
            description=f"Missing required columns: {', '.join(missing_cols)}",
            affected_rows=list(range(len(self.df))),
            field_name=', '.join(missing_cols)
        ))
    
    # Check for null values in required fields
    for field in required_fields:
        if field in self.df.columns:
            null_mask = self.df[field].isna()
            self.add_issue(
                check_name=f"Null Check: {field}",
                severity="CRITICAL",
                description=f"Null values found in required field {field}",
                mask=null_mask,
                field_name=field
            )

def check_premium_completeness(self):
    """At least one premium field should be populated for active policies."""
    if 'INIT_POLS_IF' not in self.df.columns:
        return
        
    prem_fields = ['UL_PREM', 'ADD_DTH_PREM', 'TPD_PREM', 'WOP_PREM', 'SINGLE_PREM']
    existing_prem_fields = [f for f in prem_fields if f in self.df.columns]
    
    if existing_prem_fields:
        active_mask = self.df['INIT_POLS_IF'] > 0
        all_prem_zero = (self.df[existing_prem_fields].fillna(0).sum(axis=1) == 0)
        issue_mask = active_mask & all_prem_zero
        
        self.add_issue(
            check_name="Premium Completeness",
            severity="WARNING",
            description="Active policies with zero premiums across all premium fields",
            mask=issue_mask,
            field_name="UL_PREM"
        )

# -------------------------------------------------------------------------
# 2. VALIDITY CHECKS (Range & Domain)
# -------------------------------------------------------------------------

def check_age_validity(self):
    """Check age fields are within reasonable bounds."""
    if 'AGE_AT_ENTRY' in self.df.columns:
        # Entry age bounds
        mask_low = self.df['AGE_AT_ENTRY'] < BOUNDS['age_entry_min']
        mask_high = self.df['AGE_AT_ENTRY'] > BOUNDS['age_entry_max']
        
        self.add_issue(
            check_name="Age at Entry - Too Low",
            severity="CRITICAL",
            description=f"Entry age below {BOUNDS['age_entry_min']}",
            mask=mask_low,
            field_name="AGE_AT_ENTRY"
        )
        
        self.add_issue(
            check_name="Age at Entry - Too High",
            severity="WARNING",
            description=f"Entry age above {BOUNDS['age_entry_max']}",
            mask=mask_high,
            field_name="AGE_AT_ENTRY"
        )
    
    # Current age calculation check
    if 'AGE_AT_ENTRY' in self.df.columns and 'DURATIONIF_M' in self.df.columns:
        current_age = self.df['AGE_AT_ENTRY'] + self.df['DURATIONIF_M'] / 12
        mask_impossible = current_age > BOUNDS['age_max']
        
        self.add_issue(
            check_name="Implied Current Age",
            severity="CRITICAL",
            description=f"Implied current age exceeds {BOUNDS['age_max']} years",
            mask=mask_impossible,
            field_name="AGE_AT_ENTRY"
        )

def check_sex_codes(self):
    """Validate sex coding."""
    if 'SEX' in self.df.columns:
        valid_codes = list(SEX_CODES.keys())
        invalid_mask = ~self.df['SEX'].isin(valid_codes)
        
        self.add_issue(
            check_name="Sex Code Validity",
            severity="CRITICAL",
            description=f"Invalid sex codes (valid: {valid_codes})",
            mask=invalid_mask,
            field_name="SEX"
        )

def check_spcode_validity(self, valid_codes: list = None):
    """Validate sub-product codes."""
    if 'SPCODE' not in self.df.columns:
        return
        
    codes = valid_codes or VALID_SPCODES.get('default', [])
    invalid_mask = ~self.df['SPCODE'].isin(codes)
    
    self.add_issue(
        check_name="Sub-Product Code Validity",
        severity="CRITICAL",
        description=f"Invalid SPCODE values (valid: {codes})",
        mask=invalid_mask,
        field_name="SPCODE"
    )

def check_premium_frequency(self):
    """Validate premium frequency codes."""
    if 'PREM_FREQ' not in self.df.columns:
        return
        
    valid_freq = list(PREM_FREQ_CODES.keys())
    invalid_mask = ~self.df['PREM_FREQ'].isin(valid_freq)
    
    self.add_issue(
        check_name="Premium Frequency Validity",
        severity="CRITICAL",
        description=f"Invalid premium frequency (valid: {valid_freq})",
        mask=invalid_mask,
        field_name="PREM_FREQ"
    )

def check_file_type(self):
    """Validate file type values."""
    if 'FILE_TYPE' not in self.df.columns:
        return
        
    invalid_mask = ~self.df['FILE_TYPE'].isin(VALID_FILE_TYPES)
    
    self.add_issue(
        check_name="File Type Validity",
        severity="CRITICAL",
        description=f"Invalid FILE_TYPE (valid: {VALID_FILE_TYPES})",
        mask=invalid_mask,
        field_name="FILE_TYPE"
    )

def check_indicator_fields(self):
    """Check that indicator fields are 0 or 1."""
    indicator_fields = [
        'ADD_DTH_IND', 'TPD_IND', 'STAFF_IND', 'WAIV_IND_DTH', 'WAIV_IND_TPD',
        'WOP_DTH', 'WOP_TPD', 'NEW_ALLOC_IND'
    ]
    
    for field in indicator_fields:
        if field in self.df.columns:
            invalid_mask = ~self.df[field].isin([0, 1])
            self.add_issue(
                check_name=f"Indicator Validity: {field}",
                severity="CRITICAL",
                description=f"{field} should only contain 0 or 1",
                mask=invalid_mask,
                field_name=field
            )

def check_non_negative_fields(self):
    """Check fields that should not be negative."""
    non_negative_fields = [
        'POL_TERM_Y', 'DURATIONIF_M', 'UL_PREM', 'ADD_DTH_PREM', 'TPD_PREM',
        'WOP_PREM', 'SINGLE_PREM', 'INIT_POLS_IF', 'INIT_UNFDU_A', 'INIT_UNFDU_C',
        'PREM_PAYBL_M', 'ADB_DTH_BEN', 'ADD_DTH_BEN', 'RI_SA'
    ]
    
    for field in non_negative_fields:
        if field in self.df.columns:
            negative_mask = self.df[field] < 0
            self.add_issue(
                check_name=f"Non-Negative: {field}",
                severity="CRITICAL",
                description=f"{field} contains negative values",
                mask=negative_mask,
                field_name=field
            )

def check_percentage_fields(self):
    """Check percentage fields are within 0-100 (or 0-1 depending on convention)."""
    pct_fields = ['PESC_RATE_PC', 'ALLOC_U_C_PC', 'FIX_RI_PC']
    
    for field in pct_fields:
        if field in self.df.columns:
            # Assuming 0-100 convention based on field naming
            invalid_mask = (self.df[field] < 0) | (self.df[field] > 100)
            self.add_issue(
                check_name=f"Percentage Bounds: {field}",
                severity="WARNING",
                description=f"{field} outside 0-100 range",
                mask=invalid_mask,
                field_name=field
            )

# -------------------------------------------------------------------------
# 3. CONSISTENCY CHECKS (Cross-field logic)
# -------------------------------------------------------------------------

def check_term_consistency(self):
    """POL_TERM_Y * 12 should equal PREM_PAYBL_M (unless limited premium payment)."""
    if 'POL_TERM_Y' not in self.df.columns or 'PREM_PAYBL_M' not in self.df.columns:
        return
    
    expected_prem_months = self.df['POL_TERM_Y'] * 12
    # Allow for early payment completion (prem term <= policy term)
    inconsistent_mask = self.df['PREM_PAYBL_M'] > expected_prem_months
    
    self.add_issue(
        check_name="Term Consistency",
        severity="WARNING",
        description="PREM_PAYBL_M exceeds POL_TERM_Y * 12",
        mask=inconsistent_mask,
        field_name="PREM_PAYBL_M"
    )

def check_duration_vs_term(self):
    """Duration in-force should not exceed policy term."""
    if 'DURATIONIF_M' not in self.df.columns or 'POL_TERM_Y' not in self.df.columns:
        return
    
    term_months = self.df['POL_TERM_Y'] * 12
    exceeded_mask = self.df['DURATIONIF_M'] > term_months
    
    self.add_issue(
        check_name="Duration vs Term",
        severity="CRITICAL",
        description="Duration in-force exceeds policy term",
        mask=exceeded_mask,
        field_name="DURATIONIF_M"
    )

def check_second_life_consistency(self):
    """If AGE2_ATENTRY = 0, second life fields should all be 0/null."""
    if 'AGE2_ATENTRY' not in self.df.columns:
        return
    
    no_second_life = self.df['AGE2_ATENTRY'] == 0
    
    # Check SEX2 consistency
    if 'SEX2' in self.df.columns:
        # When no second life, SEX2 should be 0 or 9 (not a valid sex code)
        inconsistent_mask = no_second_life & self.df['SEX2'].isin([0, 1])  # Has valid sex but no age
        # Actually, if AGE2=0, SEX2 should probably be 0 too
        sex2_issue = no_second_life & (self.df['SEX2'] != 0) & (self.df['SEX2'] != 9)
        
        self.add_issue(
            check_name="Second Life Consistency",
            severity="WARNING",
            description="SEX2 populated but AGE2_ATENTRY is 0",
            mask=sex2_issue,
            field_name="SEX2"
        )

def check_premium_vs_single_premium(self):
    """If SINGLE_PREM > 0, regular premiums should typically be 0 (or vice versa)."""
    if 'SINGLE_PREM' not in self.df.columns:
        return
    
    has_single = self.df['SINGLE_PREM'] > 0
    regular_prem_fields = ['UL_PREM', 'ADD_DTH_PREM', 'TPD_PREM', 'WOP_PREM']
    existing_regular = [f for f in regular_prem_fields if f in self.df.columns]
    
    if existing_regular:
        has_regular = self.df[existing_regular].fillna(0).sum(axis=1) > 0
        both_mask = has_single & has_regular
        
        self.add_issue(
            check_name="Premium Type Consistency",
            severity="INFO",
            description="Policy has both single premium and regular premiums",
            mask=both_mask,
            field_name="SINGLE_PREM"
        )

def check_benefit_vs_indicator(self):
    """Benefits should align with their indicators."""
    # TPD benefit vs TPD indicator
    if 'TPD_IND' in self.df.columns and 'TPD_PREM' in self.df.columns:
        # If TPD_IND = 0, TPD_PREM should be 0
        inconsistent = (self.df['TPD_IND'] == 0) & (self.df['TPD_PREM'] > 0)
        self.add_issue(
            check_name="TPD Benefit Consistency",
            severity="CRITICAL",
            description="TPD_PREM > 0 but TPD_IND = 0",
            mask=inconsistent,
            field_name="TPD_PREM"
        )
        
        # If TPD_IND = 1, TPD_PREM should be > 0
        missing_prem = (self.df['TPD_IND'] == 1) & (self.df['TPD_PREM'] == 0)
        self.add_issue(
            check_name="TPD Premium Missing",
            severity="WARNING",
            description="TPD_IND = 1 but TPD_PREM = 0",
            mask=missing_prem,
            field_name="TPD_PREM"
        )
    
    # ADD benefit vs indicator
    if 'ADD_DTH_IND' in self.df.columns and 'ADD_DTH_PREM' in self.df.columns:
        inconsistent = (self.df['ADD_DTH_IND'] == 0) & (self.df['ADD_DTH_PREM'] > 0)
        self.add_issue(
            check_name="ADD Benefit Consistency",
            severity="CRITICAL",
            description="ADD_DTH_PREM > 0 but ADD_DTH_IND = 0",
            mask=inconsistent,
            field_name="ADD_DTH_PREM"
        )

def check_adb_benefits_match(self):
    """ADB_DTH_BEN and ADD_DTH_BEN often should match."""
    if 'ADB_DTH_BEN' in self.df.columns and 'ADD_DTH_BEN' in self.df.columns:
        mismatch = self.df['ADB_DTH_BEN'] != self.df['ADD_DTH_BEN']
        # Only flag if both are non-zero
        both_populated = (self.df['ADB_DTH_BEN'] > 0) & (self.df['ADD_DTH_BEN'] > 0)
        
        self.add_issue(
            check_name="ADB Benefits Mismatch",
            severity="INFO",
            description="ADB_DTH_BEN and ADD_DTH_BEN have different values",
            mask=mismatch & both_populated,
            field_name="ADB_DTH_BEN"
        )

def check_fund_value_reasonableness(self):
    """Fund values should be reasonable given premiums and duration."""
    if not all(f in self.df.columns for f in ['INIT_UNFDU_A', 'UL_PREM', 'DURATIONIF_M']):
        return
    
    # Very rough check: fund value shouldn't exceed total premiums paid * 5
    # (accounting for growth but flagging extreme outliers)
    total_prem_paid = self.df['UL_PREM'] * self.df['DURATIONIF_M']
    reasonable_max = total_prem_paid * 5  # Allow 5x for investment growth
    
    excessive_mask = (self.df['INIT_UNFDU_A'] > reasonable_max) & (total_prem_paid > 0)
    
    self.add_issue(
        check_name="Fund Value Reasonableness",
        severity="INFO",
        description="Fund value exceeds 5x total premiums paid (may need verification)",
        mask=excessive_mask,
        field_name="INIT_UNFDU_A"
    )

# -------------------------------------------------------------------------
# 4. UNIQUENESS CHECKS
# -------------------------------------------------------------------------

def check_policy_uniqueness(self):
    """Check for duplicate policy numbers."""
    if 'POL_NUMBER' not in self.df.columns:
        return
    
    duplicates = self.df.duplicated(subset=['POL_NUMBER'], keep=False)
    
    self.add_issue(
        check_name="Policy Number Uniqueness",
        severity="CRITICAL",
        description="Duplicate policy numbers found",
        mask=duplicates,
        field_name="POL_NUMBER"
    )

# -------------------------------------------------------------------------
# 5. REASONABLENESS CHECKS (Outliers & Anomalies)
# -------------------------------------------------------------------------

def check_premium_outliers(self):
    """Flag extreme premium values using IQR method."""
    prem_fields = ['UL_PREM', 'ADD_DTH_PREM', 'TPD_PREM']
    
    for field in prem_fields:
        if field not in self.df.columns:
            continue
        
        # Only consider non-zero values
        non_zero = self.df[self.df[field] > 0][field]
        if len(non_zero) < 10:  # Need enough data
            continue
        
        q1, q3 = non_zero.quantile([0.25, 0.75])
        iqr = q3 - q1
        upper_bound = q3 + 3 * iqr  # Using 3*IQR for extreme outliers
        
        outlier_mask = self.df[field] > upper_bound
        
        self.add_issue(
            check_name=f"Premium Outlier: {field}",
            severity="INFO",
            description=f"{field} exceeds {upper_bound:,.0f} (Q3 + 3*IQR)",
            mask=outlier_mask,
            field_name=field
        )

def check_sum_assured_bounds(self):
    """Check sum assured fields are within bounds."""
    sa_fields = ['ADB_DTH_BEN', 'ADD_DTH_BEN', 'RI_SA']
    
    for field in sa_fields:
        if field in self.df.columns:
            extreme_mask = self.df[field] > BOUNDS['sum_assured_max']
            self.add_issue(
                check_name=f"Sum Assured Bounds: {field}",
                severity="WARNING",
                description=f"{field} exceeds {BOUNDS['sum_assured_max']:,}",
                mask=extreme_mask,
                field_name=field
            )

def check_currency_multiplier(self):
    """Currency multiplier should typically be 1 for ZAR."""
    if 'CURRENCY_MULTIPLIER' in self.df.columns:
        not_one = self.df['CURRENCY_MULTIPLIER'] != 1
        self.add_issue(
            check_name="Currency Multiplier",
            severity="INFO",
            description="Currency multiplier is not 1 (foreign currency policy?)",
            mask=not_one,
            field_name="CURRENCY_MULTIPLIER"
        )

# -------------------------------------------------------------------------
# RUN ALL CHECKS
# -------------------------------------------------------------------------

def run_all_checks(self, valid_spcodes: list = None) -> ValidationResult:
    """
    Execute all validation checks and return results.
    
    Args:
        valid_spcodes: Optional list of valid sub-product codes
        
    Returns:
        ValidationResult object with all issues found
    """
    self.issues = []  # Reset
    
    # 1. Completeness
    self.check_required_fields()
    self.check_premium_completeness()
    
    # 2. Validity
    self.check_age_validity()
    self.check_sex_codes()
    self.check_spcode_validity(valid_spcodes)
    self.check_premium_frequency()
    self.check_file_type()
    self.check_indicator_fields()
    self.check_non_negative_fields()
    self.check_percentage_fields()
    
    # 3. Consistency
    self.check_term_consistency()
    self.check_duration_vs_term()
    self.check_second_life_consistency()
    self.check_premium_vs_single_premium()
    self.check_benefit_vs_indicator()
    self.check_adb_benefits_match()
    self.check_fund_value_reasonableness()
    
    # 4. Uniqueness
    self.check_policy_uniqueness()
    
    # 5. Reasonableness
    self.check_premium_outliers()
    self.check_sum_assured_bounds()
    self.check_currency_multiplier()
    
    # Build summary statistics
    summary = self._build_summary_stats()
    
    return ValidationResult(
        total_records=len(self.df),
        issues=self.issues,
        summary_stats=summary
    )

def _build_summary_stats(self) -> dict:
    """Build summary statistics for the data."""
    stats = {
        'total_records': len(self.df),
        'columns': list(self.df.columns),
    }
    
    # Policy counts by file type
    if 'FILE_TYPE' in self.df.columns:
        stats['file_type_dist'] = self.df['FILE_TYPE'].value_counts().to_dict()
    
    # Premium statistics
    if 'UL_PREM' in self.df.columns:
        stats['ul_prem_stats'] = {
            'mean': self.df['UL_PREM'].mean(),
            'median': self.df['UL_PREM'].median(),
            'min': self.df['UL_PREM'].min(),
            'max': self.df['UL_PREM'].max(),
            'zero_count': (self.df['UL_PREM'] == 0).sum()
        }
    
    # Fund value statistics
    if 'INIT_UNFDU_A' in self.df.columns:
        stats['fund_value_stats'] = {
            'total': self.df['INIT_UNFDU_A'].sum(),
            'mean': self.df['INIT_UNFDU_A'].mean(),
            'median': self.df['INIT_UNFDU_A'].median(),
        }
    
    return stats

# -------------------------------------------------------------------------
# REPORT GENERATION
# -------------------------------------------------------------------------

def generate_report(self, result: ValidationResult, output_path: str = 'validation_report.html'):
    """
    Generate an HTML validation report.
    
    Args:
        result: ValidationResult from run_all_checks()
        output_path: Path for the HTML report
    """
    html = self._build_html_report(result)
    
    with open(output_path, 'w') as f:
        f.write(html)
    
    print(f"Report generated: {output_path}")
    return output_path

def _build_html_report(self, result: ValidationResult) -> str:
    """Build HTML content for the report."""
    
    # Severity colors
    colors = {
        'CRITICAL': '#dc3545',
        'WARNING': '#ffc107', 
        'INFO': '#17a2b8'
    }
    
    # Count issues by severity
    critical = [i for i in result.issues if i.severity == 'CRITICAL']
    warnings = [i for i in result.issues if i.severity == 'WARNING']
    info = [i for i in result.issues if i.severity == 'INFO']
    
    # Build issues table rows
    issue_rows = ""
    for issue in sorted(result.issues, key=lambda x: ('CRITICAL', 'WARNING', 'INFO').index(x.severity)):
        sample_str = ', '.join(str(v) for v in issue.sample_values[:3]) if issue.sample_values else 'N/A'
        issue_rows += f"""
        <tr>
            <td><span class="badge badge-{issue.severity.lower()}">{issue.severity}</span></td>
            <td>{issue.check_name}</td>
            <td>{issue.description}</td>

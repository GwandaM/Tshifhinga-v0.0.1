def export_issues_to_excel(self, result: ValidationResult, output_path: str = 'validation_issues.xlsx'):
    """
    Export validation issues to Excel for detailed review.
    
    Args:
        result: ValidationResult from run_all_checks()
        output_path: Path for the Excel file
    """
    if not result.issues:
        print("No issues to export.")
        return
    
    # Build issues DataFrame
    issues_data = []
    for issue in result.issues:
        for row_idx in issue.affected_rows:
            row_data = {
                'Row_Index': row_idx,
                'Severity': issue.severity,
                'Check_Name': issue.check_name,
                'Description': issue.description,
                'Field': issue.field_name,
            }
            # Add original data values for context
            if row_idx in self.df.index:
                if 'POL_NUMBER' in self.df.columns:
                    row_data['POL_NUMBER'] = self.df.loc[row_idx, 'POL_NUMBER']
                if issue.field_name and issue.field_name in self.df.columns:
                    row_data['Field_Value'] = self.df.loc[row_idx, issue.field_name]
            
            issues_data.append(row_data)
    
    issues_df = pd.DataFrame(issues_data)
    
    with pd.ExcelWriter(output_path, engine='openpyxl') as writer:
        # Summary sheet
        summary_df = pd.DataFrame([
            {'Metric': 'Total Records', 'Value': result.total_records},
            {'Metric': 'Critical Issues', 'Value': result.critical_count},
            {'Metric': 'Warnings', 'Value': result.warning_count},
            {'Metric': 'Info', 'Value': result.info_count},
        ])
        summary_df.to_excel(writer, sheet_name='Summary', index=False)
        
        # Detailed issues
        if not issues_df.empty:
            issues_df.to_excel(writer, sheet_name='Issues_Detail', index=False)
        
        # Issue counts by check
        check_counts = issues_df.groupby(['Severity', 'Check_Name']).size().reset_index(name='Count')
        check_counts.to_excel(writer, sheet_name='Issues_By_Check', index=False)
    
    print(f"Excel report generated: {output_path}")
    return output_path
